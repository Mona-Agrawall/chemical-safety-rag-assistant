# Copy to .env and adjust. Every value is optional; defaults are shown.
# Real environment variables override this file. No secrets are required.

# ── Language model (Ollama) ───────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
LLM_TEMPERATURE=0.0
LLM_NUM_CTX=8192
LLM_CONNECT_TIMEOUT_S=5
LLM_READ_TIMEOUT_S=180
HEALTH_TIMEOUT_S=3

# ── Retrieval ─────────────────────────────────────────────────────────
# Changing EMBEDDING_MODEL or CHUNK_* requires rebuilding the index:
#   python ingest.py --rebuild
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=6
CANDIDATE_K=30
HYBRID_SEARCH=true
RRF_K=60
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MAX_HISTORY_TURNS=4

# ── Storage (relative paths are resolved from the project root) ───────
DOCS_DIR=data
INDEX_DIR=storage/index
UPLOADS_SUBDIR=uploads

# ── Limits ────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=200
MAX_QUESTION_CHARS=2000

LOG_LEVEL=INFO
